# Dariusos Environment Configuration
# Copy this file to .env and adjust values for local development or production.

# Application
PROJECT_NAME="Dariusos Road Design & Earthworks Platform"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="insecure-change-in-production-secret-key-32-bytes-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=darius
POSTGRES_PASSWORD=darius_secret
POSTGRES_DB=dariusos_db
DATABASE_URL="postgresql+psycopg2://darius:darius_secret@localhost:5432/dariusos_db"
# Fallback local sqlite for quick test runs without Docker:
# DATABASE_URL="sqlite:///./dariusos.db"

# Redis & Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Storage Directories
STORAGE_DIR="./storage"
RAW_UPLOAD_DIR="./storage/raw"
PROCESSED_DIR="./storage/processed"
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB max survey upload

# Engineering Rules Config Path
ENGINEERING_RULES_PATH="./config/engineering_rules.json"

# CORS
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
